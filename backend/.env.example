# ==============================================
# SUPABASE CONFIGURATION
# ==============================================
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ==============================================
# INSTAGRAM / FACEBOOK API
# ==============================================
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_LOGIN_APP_ID=your_instagram_login_app_id
INSTAGRAM_LOGIN_APP_SECRET=your_instagram_login_app_secret
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_business_account_id
INSTAGRAM_REDIRECT_URI=http://localhost:8000/callback/instagram

# ==============================================
# GOOGLE DRIVE API
# ==============================================
GOOGLE_DRIVE_PROJECT1_FOLDER_ID=your_project1_exports_folder_id
GOOGLE_DRIVE_TEMPLATES_FOLDER_ID=your_templates_folder_id
GOOGLE_OAUTH_TYPE=desktop

# ==============================================
# GOOGLE GEMINI AI
# ==============================================
GOOGLE_API_KEY=your_gemini_api_key
# Timeout por llamada a Gemini en Hermes (en segundos, default: 90)
HERMES_GEMINI_TIMEOUT_S=90

# ==============================================
# TOKEN ENCRYPTION (Optional)
# ==============================================
# Set TOKENS_ENCRYPTION_KEY to a valid Fernet key (32 url-safe base64-encoded bytes).
# If unset, a key is derived deterministically from SUPABASE_KEY.
# TOKENS_ENCRYPTION_KEY=

# ==============================================
# NOTES
# ==============================================
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env to git (.gitignore should exclude it)
# 3. For production, use environment variables in your hosting platform
